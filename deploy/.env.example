# Copia este fichero a .env y rellénalo. .env NUNCA se versiona.
# Copy this file to .env and fill it in. .env must NEVER be committed.

# IP LAN del host Docker: Redis y el syslog del firewall solo escuchan en ella.
# LAN IP of the Docker host: Redis and the firewall syslog listen only on it.
NAS_LAN_IP=192.168.1.10

PORTAL_PORT=8095              # solo en 127.0.0.1, para el proxy HTTPS / bound to 127.0.0.1 only, for the HTTPS proxy
PORTAL_USER=surimapa          # usuario del portal (pantalla de login) / portal user (login page)
# OBLIGATORIA / REQUIRED: hash scrypt de la contraseña / scrypt hash of the password (docs: deployment, §4)
PORTAL_PASSWORD_HASH=
# Opcional: enlace a un portal hermano en la barra (solo https://) / optional sibling portal link (https:// only)
BLEDEAGLE_URL=

# Redis: usuario "surimapa" (colector y portal). Suricata escribe sin contraseña, limitado por ACL a LPUSH.
# Redis user "surimapa" (collector and portal). Suricata writes without password, ACL-limited to LPUSH.
REDIS_PASSWORD=               # OBLIGATORIA / REQUIRED
REDIS_KEY=suricata            # igual que en el emisor / same key as the sender

# IP(s) públicas propias (coma), p. ej. la WAN del router: se tratan como locales.
# Your own public IP(s) (comma separated), e.g. the router WAN IP: treated as local.
WAN_IPS=

RETENTION_DAYS=90             # días de alertas / days of alerts kept
BACKUP_KEEP=7                 # copias diarias de la BD / daily DB backups kept
TZ=UTC                        # zona horaria de retención y copias / time zone for retention & backups

# Bloqueos del firewall (pfSense filterlog por syslog UDP) / Firewall blocks (pfSense filterlog over UDP syslog)
PFSENSE_IP=192.168.1.1        # único origen aceptado / only accepted source
FW_SYSLOG_PORT=5140
FW_IFACE=pppoe0               # interfaz WAN en filterlog / WAN interface name in filterlog
FW_RETENTION_DAYS=30

# MaxMind GeoLite2 (cuenta gratuita / free account)
GEOIPUPDATE_ACCOUNT_ID=
GEOIPUPDATE_LICENSE_KEY=
GEOIPUPDATE_EDITION_IDS=GeoLite2-City GeoLite2-ASN

# Carpeta de datos persistentes (data/, redis/, geoip/, backups/) / persistent data folder
DATA_DIR=/srv/surimapa
